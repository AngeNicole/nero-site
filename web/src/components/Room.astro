<section class="room" id="home" data-chapter="Day to night" aria-label="The Eclisse loveseat from day to night">
    <div class="stage lt" id="hstage">
      <div class="htext">
        <div class="hhead"><p class="readout"><b id="rtime">10:00</b><span id="rwhat">Daylight through the window</span></p></div>
        <div class="hlight" aria-hidden="true"><svg class="htrack" viewBox="0 0 330 74">
            <defs><radialGradient id="lampg"><stop offset="0" stop-color="#E2CF9A" stop-opacity=".95"/><stop offset="1" stop-color="#E2CF9A" stop-opacity="0"/></radialGradient></defs>
            <path class="arc" d="M10 58 A140 44 0 0 1 290 58"/><path class="done" id="hdone" d="M10 58 A140 44 0 0 1 290 58"/>
            <line class="hz" x1="0" y1="58" x2="330" y2="58"/>
            <g class="tk"><text x="10" y="72" text-anchor="middle">06</text><text x="150" y="72" text-anchor="middle">12</text><text x="290" y="72" text-anchor="middle">18</text></g>
            <circle class="sun" id="hsun" r="6.5" cx="-20" cy="-20"/>
            <g class="lampi"><path d="M308 58 V36 Q308 24 318 24 Q324 24 325 30" fill="none"/><path d="M320 30 H330 L328 37 H322 Z"/></g>
            <circle id="hlamp" cx="325" cy="38" r="16" fill="url(#lampg)" opacity="0"/>
          </svg><p class="hk"><b id="hkv">5600 K</b><span id="hkl">daylight</span></p></div>

        <div class="say">
          <div class="on"><p class="small">The Eclisse loveseat, at ten in the morning</p><h1>In daylight, every piece looks fine.</h1></div>
          <div><p class="small">Keep scrolling. The sun is going.</p><h2>At dusk, the room goes flat and grey.</h2></div>
          <div><p class="small">Night. Its own lamp, in its own place, at 2700 K.</p><h2>Then its lamp takes over. <span class="hl">Every piece, in its best light.</span></h2></div>
        </div>
        <div class="meter"><span>Scroll from day to night</span><div class="bar"><i id="barfill"></i></div></div>
      </div>
      <div class="hphoto"><img data-img="eclisse" alt="The Eclisse loveseat under its arc lamp in a green room"><canvas id="gl" aria-label="The Eclisse loveseat photographed in its room, relit as you scroll: morning sun through a window, then dusk, then night with only its lamp on"></canvas></div>
    </div>
  </section>
